  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "jszip": "3.10.1",
    "lucide": "1.54.0"
  },
  "devDependencies": {
    "acorn": "8.15.0",
    "javascript-obfuscator": "5.9.0",
    "vite": "8.3.4"
  }
}
